{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/landing", "destination": "/", "type": 301 },
      { "source": "/feed", "destination": "/app", "type": 301 }
    ],
    "rewrites": [
      { "source": "**", "run": { "serviceId": "unplayable", "region": "australia-southeast1" } }
    ],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/about", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/feedback", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|ico|jpg|jpeg|svg|css|js|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
